{
  "name": "Shilpkaar",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20",
      "installYarnUsingApt": false
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "forwardPorts": [5173, 4000, 8000],
  "portsAttributes": {
    "5173": {
      "label": "web",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "4000": {
      "label": "api",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "8000": {
      "label": "ml",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@9.12.1 --activate && pnpm --version && pnpm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
